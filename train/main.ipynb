   "id": "a4f57328",
   "metadata": {},
   "source": [
    "# Speaker Verification Training & Inference\n",
    "\n",
    "Complete pipeline for speaker verification using:\n",
    "- **PTM Encoder**: WavLM/HuBERT/Wav2Vec2 (multi-layer weighted sum)\n",
    "- **Handcrafted Encoder**: MFBE + F0 features with CNN\n",
    "- **Fusion Methods**: Concatenation or Cross-Attention\n",
    "- **Backbone**: ECAPA-TDNN\n",
    "- **Loss**: AAM-Softmax\n",
    "- **Features**: Early stopping, LR scheduling, heatmap visualization"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6a7dcb8c",
   "metadata": {},
   "source": [
    "## 1. Setup & Parse Arguments"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5f712c01",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Device: cuda\n",
      "GPU: NVIDIA GeForce RTX 5080\n",
      "GPU Memory: 17.09 GB\n"
     ]
    }
   ],
   "source": [
    "# Auto-reload modules\n",
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "\n",
    "import os\n",
    "import torch\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "import argparse\n",
    "import sys\n",
    "from datetime import datetime\n",
    "\n",
    "# Check device\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f\"Device: {device}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f5828c5e",
   "metadata": {},
   "outputs": [],
   "source": [
    "from config import (\n",
    "    BATCH_SIZE, NUM_EPOCHS, LEARNING_RATE, EMBEDDING_DIM,\n",
    "    MODE, FUSION_METHOD, FEATURE_MODE,\n",
    "    CHECKPOINT_DIR, BEST_MODEL_NAME,\n",
    ")\n",
    "from train import train\n",
    "\n",
    "# 1. Cấu hình các biến lặp\n",
    "ROOT_DIR = \"D:/\"\n",
    "durations = ['train_raw', 'train_vi_full']  # 'train_raw', 'train_vi_3s', 'train_vi_5s', 'train_vi_7s', 'train_vi_full'\n",
    "pretrained_models = ['hubert', 'wavlm']\n",
    "\n",
    "# Tên thư mục feature trên ổ cứng\n",
    "feature_folders = ['mfbe', 'pitch', 'mfcc', 'mfbe_pitch', 'mfcc_pitch']\n",
    "\n",
    "# Fusion methods\n",
    "fusion_methods = [\"concat\", \"cross_attention\", \"gating\"]\n",
    "\n",
    "# Map tên thư mục sang tên config FEATURE_MODE để model nhận diện đúng dim\n",
    "feat_name_map = {\n",
    "    'mfbe': 'mfbe_only',\n",
    "    'pitch': 'pitch_only',\n",
    "    'mfcc': 'mfcc_only',\n",
    "    'mfbe_pitch': 'mfbe_pitch',\n",
    "    'mfcc_pitch': 'mfcc_pitch'\n",
    "}\n",
    "\n",
    "dur_prefix_map = {\n",
    "    'train_raw': '',\n",
    "    'train_vi_3s': '3s_',\n",
    "    'train_vi_5s': '5s_',\n",
    "    'train_vi_7s': '7s_',\n",
    "    'train_vi_full': 'full_'\n",
    "}\n",
    "\n",
    "def get_base_args():\n",
    "    \"\"\"Hàm tạo arguments cơ bản giống như lúc parse_args()\"\"\"\n",
    "    parser = argparse.ArgumentParser()\n",
    "    # Thêm các đối số cơ bản\n",
    "    parser.add_argument(\"--output_dir\", type=str, default=\"./outputs\")\n",
    "    parser.add_argument(\"--batch_size\", type=int, default=256)\n",
    "    parser.add_argument(\"--learning_rate\", type=float, default=0.001)\n",
    "    parser.add_argument(\"--lr_scheduler\", type=str, default=\"plateau\")\n",
    "    parser.add_argument(\"--num_epochs\", type=int, default=100)\n",
    "    parser.add_argument(\"--optimizer\", type=str, default=\"adam\")\n",
    "    parser.add_argument(\"--weight_decay\", type=float, default=0.001)\n",
    "    parser.add_argument(\"--aam_margin\", type=float, default=0.2)\n",
    "    parser.add_argument(\"--aam_scale\", type=float, default=30)\n",
    "    parser.add_argument(\"--embedding_dim\", type=int, default=512)\n",
    "    parser.add_argument(\"--mixed_precision\", type=bool, default=True)\n",
    "    parser.add_argument(\"--early_stop_patience\", type=int, default=5)\n",
    "    parser.add_argument(\"--seed\", type=int, default=42)\n",
    "    \n",
    "    # Sẽ gán động trong lúc lặp\n",
    "    parser.add_argument(\"--mode\", type=int, default=3)\n",
    "    parser.add_argument(\"--exp_name\", type=str, default=\"\")\n",
    "    parser.add_argument(\"--embedding_path\", type=str, default=\"\")\n",
    "    parser.add_argument(\"--feature_path\", type=str, default=\"\")\n",
    "    parser.add_argument(\"--feature_mode\", type=str, default=\"\")\n",
    "    parser.add_argument(\"--fusion_method\", type=str, default=\"\")\n",
    "    parser.add_argument(\"--use_gating\", type=bool, default=False)\n",
    "    \n",
    "    # Custom fields để lưu lại log\n",
    "    parser.add_argument(\"--duration\", type=str, default=\"\")\n",
    "    parser.add_argument(\"--pretrained_model\", type=str, default=\"\")\n",
    "    \n",
    "    args, _ = parser.parse_known_args([])\n",
    "    return args\n",
    "\n",
    "def check_skip(exp_name):\n",
    "    \"\"\"Cơ chế Skip if done: Kiểm tra xem kết quả đã tồn tại chưa\"\"\"\n",
    "    results_file = os.path.join(\"./outputs/experiments\", exp_name, \"results.json\")\n",
    "    if os.path.exists(results_file):\n",
    "        print(f\"⏭ Bỏ qua {exp_name} - Đã huấn luyện xong!\")\n",
    "        return True\n",
    "    return False"
   ]
  },
