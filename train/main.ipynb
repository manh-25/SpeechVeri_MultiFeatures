    "# ============================================================================\n",
    "# START GRID SEARCH\n",
    "# ============================================================================\n",
    "\n",
    "# 1. CHẠY MODE 1 (Chỉ PTM) - 15 Experiments\n",
    "for dur in durations:\n",
    "    for ptm in pretrained_models:\n",
    "        exp_name = f\"Mode1_PTM_{dur}_{ptm}\"\n",
    "        if check_skip(exp_name): continue\n",
    "        \n",
    "        print(f\"\\n{'='*60}\\nĐANG CHẠY: {exp_name}\\n{'='*60}\")\n",
    "        args = get_base_args()\n",
    "        args.mode = 1\n",
    "        args.exp_name = exp_name\n",
    "        args.duration = dur\n",
    "        args.pretrained_model = ptm\n",
    "        args.feature_mode = \"N/A\"\n",
